# ══════════════════════════════════════════════
# VAYA GoodsDeliveryApp — .gitignore
# ══════════════════════════════════════════════

# ── Node.js ──────────────────────────────────
**/node_modules/
**/dist/
**/.env
**/.env.*
**/*.log
npm-debug.log*
.node/

# ── macOS ────────────────────────────────────
.DS_Store
**/.DS_Store

# ── IDEs / Editors ───────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Flutter / Dart ───────────────────────────
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/generated_plugin_registrant.dart

# ── Android Gradle Build Cache ───────────────
**/.gradle/
**/.cxx/
**/local.properties

# ── Build Output Artifacts ───────────────────
apks/
aabs/

# ── Firebase Local Emulator / Cache ──────────
.firebase/
.firebaserc

# ── Private / Secrets / Keys ─────────────────
**/serviceAccountKey.json
**/google-services.json
**/key.properties
**/*.jks
**/*.keystore

# ── Scratch / Temp / Download Artifacts ──────
temp/
downloads
appDeployment
scratch/

# ── Web Guidelines Cache ────────────────────
.modern_web_guidelines.md
